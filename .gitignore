# Python
__pycache__/
*.pyc

# 打包产物与工作目录（build.bat 可重建）
build/
dist/

# ⚠ 运行时真实数据（OBS 密码/歌单/时长/设置）——严禁入库
config.json
playlist.json
_bak_dist/
crash.log
crash.log.*

# 测试/渲染输出物（工具可再生）
_render/
夜测_results.json
夜测_log.txt

# 本机工具状态
.mimosa/
.zcode/
debug.log

# 安卓工程（gradle 可重建；local.properties 是本机 SDK 路径）
mobile/.gradle/
mobile/build/
mobile/app/build/
mobile/local.properties

# APK 构建产物副本（源头 mobile/app/build；dist 内由 build.bat 拷入）
/CubeRemote.apk

# 可再生调试产物（一次性调试脚本/截图/日志全部不入库；仅打包冒烟件
# out/_smoke_dist.py 除外——build.bat 引用）
out/*
!out/_smoke_dist.py
# 合并工程原型测试件（1.2GB 工程/媒体，本地保留不入库）
out/mergetest/
stall*.log*
tmp*.log
# 运行数据滚动备份（与 config.json/playlist.json 同理不入库）
config.json.bak*
playlist.json.bak*
.video_agent/
.v2c/

# 安卓 release 签名（密钥与口令不入库；模板见 keystore.properties.example）
mobile/keystore/
mobile/keystore.properties

# iOS 本机构建产物（Xcode/SwiftPM）
ios/.build/
ios/**/.build/
ios/**/xcuserdata/
ios/**/*.xcuserstate
.DS_Store
ios/build/

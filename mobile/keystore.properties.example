# 安卓 release 签名模板：复制为 mobile/keystore.properties（已 gitignore），
# 用 keytool 生成 keystore 后填入真实值（口令任选，妥善保存——换口令重签
# =用户必须卸载重装）。
#   keytool -genkeypair -v -keystore mobile/keystore/cubesetlist-release.keystore \
#     -alias cubesetlist -keyalg RSA -keysize 2048 -validity 10950 \
#     -storepass <口令> -keypass <口令> -dname "CN=CubeSetlistManager, OU=Personal, O=Kaizhou Xie, C=CN"
storeFile=keystore/cubesetlist-release.keystore
storePassword=REPLACE
keyAlias=cubesetlist
keyPassword=REPLACE
